#!/bin/bash
set -e

# S2I Run Script for React Frontend

# 1. Runtime Config Injection
# 1. Runtime Config Injection
# We inject environment variables into the static HTML so the browser can see them.
echo "---> Injecting Runtime Config..."
# Build the JSON object dynamically
CONFIG_JSON="window.__RUNTIME_CONFIG__ = {"

if [ -n "$VITE_CLERK_PUBLISHABLE_KEY" ]; then
    CONFIG_JSON="$CONFIG_JSON \"VITE_CLERK_PUBLISHABLE_KEY\": \"$VITE_CLERK_PUBLISHABLE_KEY\","
fi

if [ -n "$VITE_POSTHOG_KEY" ]; then
    CONFIG_JSON="$CONFIG_JSON \"VITE_POSTHOG_KEY\": \"$VITE_POSTHOG_KEY\","
fi

if [ -n "$VITE_POSTHOG_HOST" ]; then
    CONFIG_JSON="$CONFIG_JSON \"VITE_POSTHOG_HOST\": \"$VITE_POSTHOG_HOST\","
fi

# Close JSON (remove trailing comma trick: adding empty key or just replace last comma?)
# Simpler approach: just list them all, trailing comma is invalid in strict JSON but valid in JS object, 
# but let's be safe. We'll simply append " \"_end\": true };" to handle the trailing comma.
CONFIG_JSON="$CONFIG_JSON \"_valid\": true };"

# Replace the placeholder in index.html (safely using a temp file)
# Note: We target dist/index.html because that is what 'serve' uses.
sed "s|<script id=\"runtime-config\"></script>|<script>$CONFIG_JSON</script>|g" dist/index.html > dist/index.html.tmp && mv dist/index.html.tmp dist/index.html

echo "---> Starting Frontend Server..."
# Using 'serve' (installed in assemble)
# -s: Single-Page Application (rewrites 404 to index.html)
# -l: Listen Port (default 3000, override via environment)
PORT=${PORT:-3000}
exec npx serve -s dist -l $PORT
