#!/bin/sh
# Code-only guard for goat-yard-archive (a PUBLIC repo). Scans, extraction outputs, verdicts, consoles,
# and data-bearing docs live in the PRIVATE dr-voluminous repo — never here.
# This hook is a WALL, not a warning: it fails the commit. It sees staged files regardless of
# .gitignore, so it also catches `git add -f`. Install: git config core.hooksPath .githooks
#
# Three rules:
#  1) no *.png/*.json/*.jsonl/*.html/*.md/*.csv/*.txt staged under ANY code-only pipeline tree
#     (CODE_ONLY_RE below — extend it when a lane adds a directory, do NOT add an exception)
#  2) no path staged that names a private DATA directory, anywhere in the repo (DATA_DIR_RE)
#  3) no new BINARY file staged anywhere outside frontend/ (scan images must never land here)
#
# Note on rule 1: *.yaml/*.yml are deliberately NOT data-shaped — book_profile.gill.yaml is
# code-adjacent config and belongs in the tree.

# Code-only trees. Lane A (body path) and Lane B (apparatus) both live under these.
CODE_ONLY_RE='^pipeline/(reextract|body|geometry)/'
DATA_EXT_RE='\.(png|jpg|jpeg|json|jsonl|html|csv|txt|md)$'

# Private data directory NAMES. A path containing one of these is data by construction,
# whatever its extension — this catches `body_shadow_vol1/notes.py` as well as `.jsonl`.
DATA_DIR_RE='(^|/)(body_shadow[^/]*|reextract_vol[0-9]+|truthset_review|audits/cards|commentary|dr-voluminous)(/|$)'

staged=$(git diff --cached --name-only --diff-filter=AM)

d=$(printf '%s\n' "$staged" | grep -E "$CODE_ONLY_RE" | grep -E "$DATA_EXT_RE")
p=$(printf '%s\n' "$staged" | grep -E "$DATA_DIR_RE")
b=$(git diff --cached --numstat | awk '$1=="-" && $2=="-" {print $3}' | grep -vE '^frontend/')

if [ -n "$d" ] || [ -n "$p" ] || [ -n "$b" ]; then
  echo "########################################################################"
  echo "# COMMIT REFUSED — goat-yard-archive is code-only (PUBLIC repo)."
  if [ -n "$d" ]; then
    echo "# data-shaped files under a code-only tree:"
    echo "$d" | sed 's/^/#   /'
  fi
  if [ -n "$p" ]; then
    echo "# paths naming a private DATA directory:"
    echo "$p" | sed 's/^/#   /'
  fi
  if [ -n "$b" ]; then
    echo "# new binary files outside frontend/:"
    echo "$b" | sed 's/^/#   /'
  fi
  echo "# Data belongs in the PRIVATE dr-voluminous repo."
  echo "# See pipeline/reextract/data_config.py for the data root."
  echo "# Deliberate override (know why): git commit --no-verify"
  echo "########################################################################"
  exit 1
fi
exit 0
